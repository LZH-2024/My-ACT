  <visual><global offwidth="640" offheight="480"/></visual>
  <worldbody>
    <!-- 桌面顶面为 z=0，与固定机器人底座坐标对齐。 -->
    <geom name="table" type="box" pos="0.15 0 -0.03" size="0.65 0.55 0.03" rgba="0.55 0.60 0.65 1"/>
    <light name="key_light" pos="0.2 -0.4 1.2" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light name="fill_light" pos="0.3 0.7 0.8" dir="0 -0.5 -1" diffuse="0.5 0.5 0.5"/>
    <camera name="front" pos="0.85 -0.75 0.65" xyaxes="0.74576121 0.66621335 -0.00000000 -0.28206744 0.31574714 0.90594796" fovy="42"/>
  </worldbody>
</mujoco>
